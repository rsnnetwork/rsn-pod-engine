# ─── RSN Server Environment Variables ─────────────────────────────────────────

# Server
NODE_ENV=development
PORT=3001
API_BASE_URL=http://localhost:3001
CLIENT_URL=http://localhost:5173
# The event links' site (/events/<name>-<n>), e.g. https://rsn.network once it forwards /events/* to the app.
# Leave unset to use the site the organiser is on (one of ours), else CLIENT_URL.
# EVENT_LINK_BASE_URL=https://app.rsn.network

# Database (PostgreSQL)
DATABASE_URL=postgres://rsn_dev:rsn_dev_password@localhost:5432/rsn_dev
DB_POOL_MIN=3
DB_POOL_MAX=40

# Redis
REDIS_URL=redis://localhost:6379

# JWT Authentication
JWT_SECRET=your-jwt-secret-change-in-production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Magic Link
MAGIC_LINK_SECRET=your-magic-link-secret-change-in-production
MAGIC_LINK_EXPIRY_MINUTES=15

# Email (Resend recommended)
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM=noreply@rsn.network
# Legacy SMTP (if not using Resend)
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# LiveKit
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=ws://localhost:7880

# Stripe (Billing readiness)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Anthropic (onboarding chatbot — REASON intent capture)
# Empty key = LLM disabled; onboarding falls back to the minimal form so signup
# is never blocked. Get a key at console.anthropic.com (never commit a real key).
ANTHROPIC_API_KEY=
ONBOARDING_CHAT_MODEL=claude-haiku-4-5
ONBOARDING_EXTRACT_MODEL=claude-haiku-4-5

# ScrapingDog (profile enrichment)
# Empty key = enrichment disabled. Get a key at scrapingdog.com.
SCRAPINGDOG_API_KEY=
# Rollback switch for enrichment provider: 'scrapingdog' (default), 'claude_web' (old), 'none'
ENRICH_PROVIDER=scrapingdog

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=debug

SENTRY_DSN=

# Calendar free/busy (Shirley pilot S8). Optional: members may connect a Google or Microsoft calendar so the meeting
# picker shades the times they are busy. Off unless CALENDAR_SYNC=on, and it stays off (every /api/calendar route
# answers 404) until CALENDAR_TOKEN_KEY is a 32-byte base64 key and at least one provider has an id AND a secret.
# Setup, click by click: workspace/assets/Calendar_setup_for_Ali.md
CALENDAR_SYNC=off
# Encrypts the stored calendar tokens (AES-256-GCM). Generate once: openssl rand -base64 32
# Keep a copy in the password vault: losing or changing it means every member must connect their calendar again.
CALENDAR_TOKEN_KEY=
# Optional. Where the browser starts and the providers send it back (<base>/api/calendar/<provider>/callback).
# Unset, API_BASE_URL. The redirect URIs registered with Google and Microsoft must match it exactly.
CALENDAR_REDIRECT_BASE=
# Google Cloud: an OAuth client of type Web application (scope calendar.freebusy). Not the sign-in GOOGLE_CLIENT_ID.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
# Microsoft Entra: an app registration for any organisational directory and personal accounts (Calendars.ReadBasic).
MICROSOFT_CALENDAR_CLIENT_ID=
MICROSOFT_CALENDAR_CLIENT_SECRET=
