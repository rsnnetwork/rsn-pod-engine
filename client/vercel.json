{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "cd .. && npm install && npm run build:shared && cd client && npm run build",
  "outputDirectory": "dist",
  "installCommand": "cd .. && npm install",
  "build": {
    "env": {
      "VITE_API_URL": "https://rsn-api-h04m.onrender.com/api",
      "VITE_SERVER_URL": "https://rsn-api-h04m.onrender.com",
      "VITE_SENTRY_DSN": "https://8d2c1cb564d76a30c57bde479241b450@o4511214831665152.ingest.de.sentry.io/4511214855192656"
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://rsn-api-h04m.onrender.com/api/:path*" },
    { "source": "/socket.io/:path*", "destination": "https://rsn-api-h04m.onrender.com/socket.io/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Pragma", "value": "no-cache" }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Pragma", "value": "no-cache" }
      ]
    },
    {
      "source": "/p/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "Referrer-Policy", "value": "no-referrer" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
